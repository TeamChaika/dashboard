# Django
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
DJANGO_SETTINGS_MODULE=dashboard.settings

# Database (внешний PostgreSQL сервер)
DB_NAME=iiko_db
DB_USERNAME=iiko_user
DB_PASSWORD=change-me-strong-password
DB_HOST=your-postgres-server.com  # Адрес внешнего PostgreSQL сервера
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# iiko API
IIKO_API_SERVER=https://api.iiko.ru
IIKO_API_USERNAME=your-iiko-username
IIKO_API_PASSWORD=your-iiko-password

# Telegram Bot
BOT_TOKEN=your-telegram-bot-token
APP_HOST=http://localhost:8000

# Ports
BACKEND_PORT=8000
HTTP_PORT=80
HTTPS_PORT=443

# Logging
LOG_LEVEL=INFO

# Static and Media
# STATIC_DIR больше не используется - статика собирается в /app/staticfiles
# STATIC_DIR=/app/staticfiles
MEDIA_DIR=/app/media
DATA_DIR=/app/data

